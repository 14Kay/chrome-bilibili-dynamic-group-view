{
    "compilerOptions": {
        "target": "es6",
        "jsx": "react",
        "lib": ["ES2024", "dom"],
        "rootDir": "src",
        "module": "ES6",
        "moduleResolution": "bundler",
        "typeRoots": ["node_modules/@types"],
        "strict": true,
        "noEmitOnError": true,
        "outDir": "dist/js",
        "sourceMap": false,
        "esModuleInterop": true
    }
}
